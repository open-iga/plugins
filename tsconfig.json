{
    "compilerOptions": {
        "target": "esnext",
        "moduleResolution": "bundler",
        "module": "preserve",

        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        "noEmit": true,
        "allowImportingTsExtensions": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,

        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true,

        "lib": []
    },
    // `files` is inherited by extending configs that don't set their own `files`
    // (and resolves relative to THIS file), so the Extism globals reach every
    // package automatically — no per-package reference needed.
    "files": ["extism-jspdk.d.ts"]
}
